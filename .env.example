# --- PostgreSQL ---
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=products

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=
# Публичный HTTPS-адрес Mini App (должен вести на nginx). Для локальной разработки - https-туннель (ngrok).
WEBAPP_URL=https://example.ngrok-free.app
# webhook | polling | off
BOT_MODE=webhook
# Публичный базовый URL для автоматической установки вебхука (обычно совпадает с WEBAPP_URL)
WEBHOOK_BASE_URL=https://example.ngrok-free.app
# Любая длинная случайная строка (путь /bot/webhook/{secret} и secret_token)
WEBHOOK_SECRET=replace-with-long-random-string

# Порт nginx на хосте
HTTP_PORT=8080
